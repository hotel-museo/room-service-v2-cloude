{
  "directories": {
    "buildResources": "build",
    "output": "release"
  },
  "files": [
    "main.js",
    "preload.js",
    "package.json",
    "assets/front/**",
    "build/icon-front.png"
  ],
  "appId": "kr.hotelmuseo.front.roomservice",
  "productName": "HOTEL MUSEO Front",
  "extraMetadata": {
    "phVariant": "front",
    "name": "hotel-museo-front",
    "productName": "HOTEL MUSEO Front"
  },
  "win": {
    "target": "nsis",
    "icon": "build/icon-front.png"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "shortcutName": "HOTEL MUSEO 프런트",
    "artifactName": "HOTEL-MUSEO-Front-Setup.${ext}",
    "createDesktopShortcut": true,
    "runAfterFinish": true
  }
